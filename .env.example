# LLM provider: azure | groq | gemini | opencode | ollama
HELIOAI_LLM_PROVIDER=azure

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=                   # https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=models-gpt-53-chat  # deployment name in the Azure portal
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Extra HTTP headers for an OpenAI-compatible endpoint (groq | opencode | ollama).
# Comma-separated `name=value`. Some gateways and corporate proxies require one.
# A value of {uuid} is replaced with a fresh random id each time a client is built,
# for gateways that want a per-conversation token.
#   HELIOAI_OPENCODE_HEADERS=x-session={uuid}
#   HELIOAI_GROQ_HEADERS=x-team=plasma
#   HELIOAI_OLLAMA_HEADERS=x-team=plasma
HELIOAI_OPENCODE_HEADERS=

# OpenCode's Zen gateway (https://opencode.ai) — OpenAI-compatible. Defaults to the
# Go-plan endpoint (most accounts); set HELIOAI_OPENCODE_URL to .../zen (no /go) if
# your access is full Zen/BYOK instead — the two serve different model catalogues.
# No default model: pick the exact id from your dashboard (/models on the URL above).
OPENCODE_API_KEY=
# HELIOAI_OPENCODE_MODEL=
# HELIOAI_OPENCODE_URL=https://opencode.ai/zen/go

# Ollama — local inference, no API key. Any OpenAI-compatible endpoint works here.
# HELIOAI_OLLAMA_URL=http://localhost:11434
# HELIOAI_OLLAMA_MODEL=qwen2.5:14b-instruct

# NASA ADS literature search — free token: https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=

# External MCP servers mounted into the agent (JSON object, one entry per server alias).
# stdio:  {"alphaxiv": {"command": "npx", "args": ["-y", "mcp-remote", "https://api.alphaxiv.org/mcp/v1"]}}
# http:   {"myserver": {"url": "https://host/mcp", "headers": {"Authorization": "Bearer <token>"}}}
# HELIOAI_MCP_SERVERS=

# Shared secret required by `helioai-mcp --http` as `Authorization: Bearer <token>`.
# Empty (default) = no auth — fine on the loopback default, refused on any other
# bind (see SECURITY.md). Not used over stdio.
# HELIOAI_MCP_TOKEN=

# Vision review of sandbox figures (multimodal side-call, text verdict only).
# Provider azure reuses the Azure deployment (GPT-5.x chat is multimodal); or gemini.
HELIOAI_VISION_ENABLED=0
# HELIOAI_VISION_PROVIDER=azure
# HELIOAI_VISION_MODEL=

# Judgment layer (observation only): a System One judge beside the loop. `null`
# (default) abstains on every question — the loop is exactly the one without it.
# `jev` needs the `judgment` extra and TYPESAFE_API_KEY, and a site only asks when
# its `judgment_<site>` experiment is named in HELIOAI_EXPERIMENTS. Answers are
# recorded under the session workspace (judgment.jsonl); none corrects the model.
HELIOAI_JUDGMENT_BACKEND=null
# HELIOAI_JUDGMENT_MODEL=jev-latest
# HELIOAI_JUDGMENT_TIMEOUT_S=2.0
# TYPESAFE_API_KEY=

# Agent config
HELIOAI_MAX_ITERATIONS=10
# Run a delegated role on its own provider/model instead of the lead's client:
# role=provider[:model], comma-separated. Roles: parameter_hunter, data_analyst,
# plasma_physicist, librarian. Unset = every role uses the lead's client.
# HELIOAI_ROLE_MODELS=parameter_hunter=groq:llama-3.3-70b-versatile,librarian=groq
# Behaviours under evaluation, off unless named here (comma-separated):
# deferred_tools, search_budget, search_variables. An unknown name is refused when a
# model is built (and by `helioai doctor`). Unset = the reference loop plus what the
# benchmarks promoted (run_recipe, the corrected recipes, final_answer).
# HELIOAI_EXPERIMENTS=deferred_tools
HELIOAI_LOG_FORMAT=console  # console | json
# HELIOAI_LOG_LEVEL=INFO       # overrides the level each entry point sets (DEBUG | INFO | WARNING)

# Output budget shared by every provider. Reasoning models spend it on their own
# thinking before the tool call, so too low a value truncates tool arguments rather
# than the prose. Unset → each provider keeps its own default.
# HELIOAI_MAX_OUTPUT_TOKENS=8192

# Hybrid retrieval (BM25 + dense, fused by RRF). Set to 0 for dense only.
# HELIOAI_RAG_HYBRID=1

# Session workspaces older than this are purged when the web UI starts (seconds).
# HELIOAI_WORKSPACE_TTL_S=604800

# Session DB
HELIOAI_SESSION_DB=data/sessions.db

# Storage root — everything HelioAI writes lives under it: the Chroma index, sessions.db,
# per-user homes (<data_dir>/users/<user>/: workspace + catalogs + profile).
# Defaults to <repo>/data when running from a clone, ~/.local/share/helioai when pip-installed.
# HELIOAI_DATA_DIR=data

# Saved event catalogs (speasy JSON). Defaults to <data_dir>/catalogs
# HELIOAI_CATALOGS_DIR=data/catalogs

# Derived recipes. Defaults to the copy shipped inside the package
# (helioai/data/recipes). Set this to use your own set instead.
# HELIOAI_RECIPES_DIR=

# Dev token — unlocks unrestricted LLM access (bypasses helio-only scope guardrail).
# Leave empty (or unset) to keep the instance fully restricted (production default).
# HELIOAI_DEV_TOKEN=

# Web UI authentication: "token:user_id" pairs, comma-separated. Each user gets its
# own storage under <data>/users/<user_id>/. Unset → no auth and a single local user,
# which is the only supported mode for a localhost bind.
# HELIOAI_USERS=tok1:vincent,tok2:alice

# `helioai serve --web --host 0.0.0.0` refuses to start with no HELIOAI_USERS, like the MCP
# HTTP server without a token. Only opt out inside a container whose port the host
# publishes on loopback (docker-compose.yml does this for you).
# HELIOAI_ALLOW_UNAUTHENTICATED_PUBLIC=0
